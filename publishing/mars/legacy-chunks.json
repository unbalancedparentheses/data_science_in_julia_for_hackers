    {
      "options": ", results = FALSE",
      "code": "@model gravity_angle_uniform(t_final, x_final, θ) = begin\n    # The number of observations.\n\terror = 15\n\tangle ~ Uniform(45 - error/2, 45 + error/2)\n\tg ~ LogNormal(log(4),0.3)\n\tμ = g .* (t_final.*t_final./(2 * tan.(deg2rad(angle))))\n\t\t\n\tN = length(t_final)\n    for n in 1:N\n\t\tx_final[n] ~ Normal(μ[n], 10)\n    end\nend",
      "html": "<div class=\"sourceCode\" id=\"cb19\"><pre class=\"sourceCode julia\"><code class=\"sourceCode julia\"><span id=\"cb19-1\"><a href=\"escaping-from-mars.html#cb19-1\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">@model</span> <span class=\"fu\">gravity_angle_uniform</span>(t_final, x_final, θ) <span class=\"op\">=</span> <span class=\"cf\">begin</span></span>\n<span id=\"cb19-2\"><a href=\"escaping-from-mars.html#cb19-2\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"co\"># The number of observations.</span></span>\n<span id=\"cb19-3\"><a href=\"escaping-from-mars.html#cb19-3\" aria-hidden=\"true\" tabindex=\"-1\"></a>    error <span class=\"op\">=</span> <span class=\"fl\">15</span></span>\n<span id=\"cb19-4\"><a href=\"escaping-from-mars.html#cb19-4\" aria-hidden=\"true\" tabindex=\"-1\"></a>    angle <span class=\"op\">~</span> <span class=\"fu\">Uniform</span>(<span class=\"fl\">45</span> <span class=\"op\">-</span> error<span class=\"op\">/</span><span class=\"fl\">2</span>, <span class=\"fl\">45</span> <span class=\"op\">+</span> error<span class=\"op\">/</span><span class=\"fl\">2</span>)</span>\n<span id=\"cb19-5\"><a href=\"escaping-from-mars.html#cb19-5\" aria-hidden=\"true\" tabindex=\"-1\"></a>    g <span class=\"op\">~</span> <span class=\"fu\">LogNormal</span>(<span class=\"fu\">log</span>(<span class=\"fl\">4</span>),<span class=\"fl\">0.3</span>)</span>\n<span id=\"cb19-6\"><a href=\"escaping-from-mars.html#cb19-6\" aria-hidden=\"true\" tabindex=\"-1\"></a>    μ <span class=\"op\">=</span> g <span class=\"op\">.*</span> (t_final<span class=\"op\">.*</span>t_final<span class=\"op\">./</span>(<span class=\"fl\">2</span> <span class=\"op\">*</span> <span class=\"fu\">tan</span>.(<span class=\"fu\">deg2rad</span>(angle))))</span>\n<span id=\"cb19-7\"><a href=\"escaping-from-mars.html#cb19-7\" aria-hidden=\"true\" tabindex=\"-1\"></a>        </span>\n<span id=\"cb19-8\"><a href=\"escaping-from-mars.html#cb19-8\" aria-hidden=\"true\" tabindex=\"-1\"></a>    N <span class=\"op\">=</span> <span class=\"fu\">length</span>(t_final)</span>\n<span id=\"cb19-9\"><a href=\"escaping-from-mars.html#cb19-9\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">for</span> n <span class=\"kw\">in</span> <span class=\"fl\">1</span><span class=\"op\">:</span>N</span>\n<span id=\"cb19-10\"><a href=\"escaping-from-mars.html#cb19-10\" aria-hidden=\"true\" tabindex=\"-1\"></a>        x_final[n] <span class=\"op\">~</span> <span class=\"fu\">Normal</span>(μ[n], <span class=\"fl\">10</span>)</span>\n<span id=\"cb19-11\"><a href=\"escaping-from-mars.html#cb19-11\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">end</span></span>\n<span id=\"cb19-12\"><a href=\"escaping-from-mars.html#cb19-12\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"cf\">end</span></span></code></pre></div>"
